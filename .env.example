# Copy to .env and fill in real values locally. Never commit .env.

# Postgres (Supabase) connection string
DATABASE_URL=

# MQTT broker (HiveMQ Cloud Serverless)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Admin SDK (for verifying ID tokens + sending FCM push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Notification channels (paid fallbacks)
MSG91_API_KEY=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# REST API
PORT=3000
